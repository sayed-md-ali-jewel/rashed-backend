# ==========================================
# Backend .gitignore (Strapi v5 / Node.js)
# ==========================================

# Dependencies
node_modules/
.pnpm-store/

# Environment Variables & Secrets
.env
.env.*
!.env.example
!.env.*.example
!.env.development.example
!.env.production.example

# Build Outputs
dist/
build/
deploy/

# Strapi Caches & Temporary Storage
.cache/
.tmp/
.strapi/
.strapi-updater.json

# Local Uploads (ignore uploaded media files, keep .gitignore)
public/uploads/*
!public/uploads/.gitignore

# Local SQLite databases (if used locally)
*.db
*.sqlite
*.sqlite3

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript
*.tsbuildinfo
tsconfig.tsbuildinfo

# OS & Editor Files
.DS_Store
.DS_Store?
._*
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
*.swp
*.swo
